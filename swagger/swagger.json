{
    "swagger": "2.0",
    "info": {
        "description": "KMS service for Compute TEE",
        "title": "Compute TEE KMS API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/addresses": {
            "get": {
                "description": "Derive EVM addresses from app's HD wallet",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "addresses"
                ],
                "summary": "Get EVM addresses",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Application ID",
                        "name": "appID",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of addresses to derive (default: 1, max: 100)",
                        "name": "count",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/types.SignedResponse-types_AddressesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/env": {
            "post": {
                "description": "Retrieve encrypted environment variables and mnemonic for authenticated app",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "environment"
                ],
                "summary": "Get environment variables",
                "parameters": [
                    {
                        "description": "Encrypted JWT + RSA public key data",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/types.EnvRequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "App ID override (debug mode only)",
                        "name": "appID",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/types.SignedResponse-types_EnvResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Get server health status",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "types.AddressesResponse": {
            "type": "object",
            "properties": {
                "evmAddresses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/types.EVMAddressAndDerivationPath"
                    }
                },
                "solanaAddresses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/types.SolanaAddressAndDerivationPath"
                    }
                }
            }
        },
        "types.EVMAddressAndDerivationPath": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string",
                    "example": "0x1234567890abcdef1234567890abcdef12345678"
                },
                "derivationPath": {
                    "type": "string"
                }
            }
        },
        "types.EnvRequest": {
            "type": "object",
            "properties": {
                "encryptedJwtWithRsaKey": {
                    "type": "string"
                }
            }
        },
        "types.EnvResponse": {
            "type": "object",
            "properties": {
                "encryptedCombinedEnv": {
                    "type": "string"
                }
            }
        },
        "types.SignedResponse-types_AddressesResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/types.AddressesResponse"
                },
                "signature": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                }
            }
        },
        "types.SignedResponse-types_EnvResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/types.EnvResponse"
                },
                "signature": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                }
            }
        },
        "types.SolanaAddressAndDerivationPath": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "derivationPath": {
                    "type": "string"
                }
            }
        }
    }
}